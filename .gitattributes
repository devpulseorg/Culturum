# Auto detect text files and perform LF normalization
* text=auto

# Native Git Binary Media Rules (No Git LFS dependency for Vercel and CI deployments)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.mp4 binary
*.mov binary
*.webm binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
